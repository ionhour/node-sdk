{
  "name": "@ionhour/express",
  "version": "0.1.0",
  "description": "Ionhour Express SDK -- heartbeat monitoring middleware and client helpers for Express apps.",
  "license": "MIT",
  "type": "commonjs",
  "main": "./src/index.js",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "ionhour",
    "monitoring",
    "uptime",
    "heartbeat",
    "cron",
    "express",
    "middleware"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ionhour/node-sdk.git",
    "directory": "express"
  },
  "homepage": "https://github.com/ionhour/node-sdk#readme",
  "bugs": {
    "url": "https://github.com/ionhour/node-sdk/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@ionhour/core": "^0.1.0"
  },
  "peerDependencies": {
    "express": "^4.18.0 || ^5.0.0"
  }
}
